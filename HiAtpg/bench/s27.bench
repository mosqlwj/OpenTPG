# 8 inputs
# 2 outputs
# 3 D-type flipflops
# 3 MUXs
# 2 inverters
# 8 gates (1 ANDs + 1 NANDs + 2 ORs + 4 NORs)

INPUT(SI)
INPUT(SEL)
INPUT(CLK1)
INPUT(G00)
INPUT(G10)
INPUT(G20)
INPUT(G30)

OUTPUT(G60)
OUTPUT(G170)

G50 = DFF(CLK1,G100)
G70 = DFF(CLK1,GMUX1)
G60 = DFF(CLK1,GMUX2)

GMUX1 = MUX(SEL,G130,SI)
GMUX2 = MUX(SEL,G110,G70)

G140 = NOT(G00)
G170 = NOT(G110)


G80 = AND(G140,G60)

G90 = NAND(G160,G150)

G150 = OR(G120,G80)
G160 = OR(G30,G80)

G100 = NOR(G140,G110)
G110 = NOR(G50,G90)
G120 = NOR(G10,G70)
G130 = NOR(G20,G120)



