#include <gtest/gtest.h>

#include "flowtpg/model/Netlist.h"

class NetlistTest : public ::testing::Test
{
protected:
    void SetUp() override
    {
        netlist = new Netlist();
    }

    void TearDown() override
    {
        delete netlist;
    }

    Netlist* netlist;
};

TEST_F(NetlistTest, CreateNetlist)
{
    ASSERT_NE(netlist, nullptr);
}

TEST_F(NetlistTest, InitialPICount)
{
    EXPECT_EQ(netlist->GetPICount(), 0);
}

TEST_F(NetlistTest, InitialScanCellCount)
{
    EXPECT_EQ(netlist->GetScanCellCount(), 0);
}

TEST_F(NetlistTest, InitialCubeEndId)
{
    EXPECT_EQ(netlist->GetCubeEndId(), 0);
}

TEST_F(NetlistTest, GatesVector)
{
    const std::vector<Gate*>& gates = netlist->Gates();
    EXPECT_EQ(gates.size(), 0);
}

TEST_F(NetlistTest, GateNameMap)
{
    const auto& gateNameMap = netlist->GetGateNameMap();
    EXPECT_EQ(gateNameMap.size(), 0);
}
